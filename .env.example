# IHG Guest Search BFF configuration (placeholders only).
# Copy to .env for local development. Never commit a real .env file.
# Keys map 1:1 to AppConfig in apps/bff/src/config.ts. Values shown equal the loader's
# defaults, except UI_MEMBER_TYPES (placeholder) and the REQUIRED keys (no default;
# startup fails if unset or empty):
#   SESSION_SECRET, SOAP_ENDPOINT, SOAP_ACTION, SOAP_HEADER_LANGUAGE_CODE,
#   SOAP_HEADER_COUNTRY_CODE, SOAP_HEADER_CHANNEL, SOAP_HEADER_SUB_CHANNEL,
#   SOAP_HEADER_ENVIRONMENT, SOAP_HEADER_SERVICE_USER
# Empty values count as unset. Booleans accept exactly true or false.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
TRUST_PROXY=false

# --- Auth --------------------------------------------------------------------
# dev = DevAuthProvider (refuses to start when NODE_ENV=production); oidc = not yet implemented
AUTH_MODE=dev
DEV_AUTH_USER_ID=dev-user-001
DEV_AUTH_DISPLAY_NAME=Dev Colleague
# Comma-separated role names
DEV_AUTH_ROLES=GuestSearch.Read,GuestSearch.RevealPII

# --- Session -----------------------------------------------------------------
# Leave empty to use the default (gs_session on http://localhost, __Host-Http-gs_session otherwise)
SESSION_COOKIE_NAME=
# Idle timeout (minutes) and absolute lifetime (hours)
SESSION_TTL_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Secret, resolved through SecretProvider. At least 32 characters of random data.
SESSION_SECRET=replace-with-a-long-random-local-only-value

# --- SOAP service ------------------------------------------------------------
SOAP_ENDPOINT=http://localhost:8080/GuestSearchService
SOAP_ACTION=placeholder-soap-action
SOAP_CONNECT_TIMEOUT_MS=3000
SOAP_RESPONSE_TIMEOUT_MS=10000
SOAP_MAX_RESPONSE_BYTES=2097152
SOAP_MAX_RESULTS=50

# Optional TLS / mTLS file paths (leave empty when not used)
SOAP_TLS_CA_FILE=
SOAP_TLS_CERT_FILE=
SOAP_TLS_KEY_FILE=

# Address feature flags (default false until confirmed against the XSD)
SOAP_FEATURE_ADDRESS_LINE1=false
SOAP_FEATURE_CITY=false
SOAP_FEATURE_POSTAL_CODE=false

# SOAP header values (placeholders until supplied by IHG)
SOAP_HEADER_LANGUAGE_CODE=en
SOAP_HEADER_COUNTRY_CODE=US
SOAP_HEADER_CHANNEL=placeholder-channel
SOAP_HEADER_SUB_CHANNEL=placeholder-subchannel
SOAP_HEADER_ENVIRONMENT=local
# Service user and credential are resolved through SecretProvider
SOAP_HEADER_SERVICE_USER=placeholder-service-user
SOAP_HEADER_SEQUENCE=1
# Optional; attached only once the contract defines its location (Blockers B5/B6)
SOAP_SERVICE_CREDENTIAL=

# Circuit breaker
SOAP_BREAKER_FAILURE_THRESHOLD=5
SOAP_BREAKER_OPEN_MS=30000

# --- Rate limits (per session) -------------------------------------------------
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_REVEAL_PER_MINUTE=10

# --- PII reveal ----------------------------------------------------------------
REVEAL_TTL_MINUTES=10

# --- UI config (served by GET /api/v1/config) ---------------------------------
UI_SCORE_BAND_HIGH=90
UI_SCORE_BAND_MEDIUM=70
# JSON array of { code, label } with unique codes (default []); placeholder until the
# Member Type code set is supplied
UI_MEMBER_TYPES=[{"code":"PLACEHOLDER","label":"Placeholder member type"}]

# --- Logging -------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
AUDIT_LOG_PATH=logs/audit.jsonl

# --- Telemetry -----------------------------------------------------------------
# none | console | otlp
TELEMETRY_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
