<?xml version="1.0" encoding="UTF-8"?>
<!--
  searchGuestResponse: 60 synthetic guests for the E2E pagination tests (more than one page
  of 50; needs maxResults >= 60). WireMock scenario "Many".
  GENERATED: apps/bff/test/fixtures/soap/response-60-guests.xml is rendered from
  scripts/templates/response-60-guests.template.xml by scripts/gen-fixtures.ts
  (npm run gen:fixtures). Edit the template, never the generated file; a test fails on drift.
  Synthetic data only. Provisional element placement until Blocker B1 (XSD).
-->
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Header/>
  <soap:Body>
    <ns4:searchGuestResponse xmlns="http://atp.ihg.com/schema/common/ATPCommonServiceTypes/v1" xmlns:ns2="http://crm.ihg.com/schema/v1_0/initiate" xmlns:ns3="http://common.crm.ihg.com/schema/v1_0/complex" xmlns:ns4="http://atp.ihg.com/schema/crs/initiate/servicetypes/v1" xmlns:ns5="http://common.crm.ihg.com/schema/v1_0/basictypes">
      <header>
        <transactionStatus overallStatusCode="0000" overallStatusDescription="Success" transactionSuccessful="true"/>
      </header>
{{#guest}}
      <ns2:initiateGuest score="{{score}}" status="A">
        <ns2:enterpriseId>9000000{{nn}}</ns2:enterpriseId>
        <ns3:name>
          <ns5:given>Guest{{nn}}</ns5:given>
          <ns5:surname>Many</ns5:surname>
        </ns3:name>
        <ns3:address locationCode="H" profileDefault="true">
          <ns3:source>
            <ns5:line1>1{{nn}} Example Way</ns5:line1>
            <ns5:locality1>Atlanta</ns5:locality1>
            <ns5:region1>GA</ns5:region1>
            <ns5:postalCode>30399</ns5:postalCode>
            <ns5:country>US</ns5:country>
          </ns3:source>
        </ns3:address>
        <ns3:phone number="+1 404 555 01{{nn}}" type="MOBILE" location="H" profileDefault="true"/>
        <ns3:email profileDefault="true">
          <ns5:address>guest{{nn}}.many@example.test</ns5:address>
        </ns3:email>
        <ns3:membership code="PLACEHOLDER" value="9000000{{nn}}" status="ACTIVE"/>
      </ns2:initiateGuest>
{{/guest}}
    </ns4:searchGuestResponse>
  </soap:Body>
</soap:Envelope>
