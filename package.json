{
  "name": "ihg-guest-search",
  "version": "0.0.0",
  "private": true,
  "description": "Internal IHG Guest Search: React SPA, Fastify BFF and shared schema over the SOAP searchGuestRequest operation.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.15"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && tsc -p tools/tsconfig.json && tsc -p e2e/tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e:stack": "node scripts/e2e-stack.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "gen:fixtures": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/gen-fixtures.ts",
    "mock:soap": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/mock-soap/server.ts",
    "build:backend": "npm run build --workspace=@ihg-guest-search/shared && npm run build --workspace=@ihg-guest-search/bff",
    "dev": "npm run dev --workspaces --if-present",
    "dev:all": "node scripts/dev-all.mjs",
    "stub:up": "docker compose -f tools/wiremock/docker-compose.dev.yml up -d",
    "stub:down": "docker compose -f tools/wiremock/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
